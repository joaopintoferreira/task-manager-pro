# ============================================================
# VARIÁVEIS DE AMBIENTE — Task Manager
# Copie este arquivo para .env e preencha com seus valores
# NUNCA comite o .env no repositório!
# ============================================================

# Ambiente
FLASK_ENV=development
DEBUG=True

# Chave secreta (gere uma nova com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=GERE_UMA_CHAVE_AQUI

# ── Banco de dados ──────────────────────────────────────────
# Desenvolvimento local (SQLite)
DEV_DATABASE_URL=sqlite:///dev_task_manager.db

# NeonDB (PostgreSQL) — copie em Neon Console > Connect.
# Use o host com "-pooler" (connection pooling) para a aplicação e para a Vercel.
# Para rodar migrações (flask db upgrade) prefira a string direta, sem "-pooler".
# O Neon exige TLS (sslmode=require).
# Se DATABASE_URL não for definida/PostgreSQL, a aplicação usa SQLite (DEV_DATABASE_URL).
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/NOME_DO_BANCO?sslmode=require

# ── JWT ─────────────────────────────────────────────────────
# Access token em minutos (padrão 15); refresh token em dias (padrão 7)
JWT_ACCESS_EXPIRY=15
JWT_REFRESH_EXPIRY=7

# ── CORS ────────────────────────────────────────────────────
# Na Vercel o frontend e a API usam o mesmo domínio, então CORS_ORIGINS não é necessário.
# Desenvolvimento
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# Só se o frontend ficar em outro domínio:
# CORS_ORIGINS=https://seu-frontend.exemplo.com

# ── Pool de conexões (produção / serverless) ─────────────────
# Mantenha baixo: o pooling real é feito pelo endpoint -pooler do Neon.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0

# ── Assistente de IA (opcional) ──────────────────────────────
# Sem AI_PROVIDER, AI_API_KEY e AI_MODEL o assistente fica desativado (a tela avisa que não está configurado).
# Detalhes, como obter a chave e escolher o modelo: docs/AI_ASSISTANT.md
# A chave é PRIVADA: preencha-a só no seu .env local, nunca neste exemplo.

# groq | openrouter
AI_PROVIDER=groq
AI_API_KEY=
# Identificador exato do modelo, sem valor padrão (confirme no painel do provedor)
AI_MODEL=
# Opcional: vazio usa o endpoint oficial do provedor
AI_BASE_URL=
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=600
